diff --git a/cloudflare/wayon-cloud/src/device_reissue.mjs b/cloudflare/wayon-cloud/src/device_reissue.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..4a76741ed88bf1ee7db6052261f9140e2bb2aefb
--- /dev/null
+++ b/cloudflare/wayon-cloud/src/device_reissue.mjs
@@ -0,0 +1,149 @@
+// Device identity is verified independently of the lost Wayon bearer key.
+// Never accept a DongleId, a client-supplied public key, or LAN membership as proof.
+const encoder = new TextEncoder();
+const reply = (body, status = 200) => new Response(JSON.stringify(body), {
+  status, headers: { "content-type": "application/json", "cache-control": "no-store" },
+});
+const b64bytes = value => Uint8Array.from(atob(value.replace(/-/g, "+").replace(/_/g, "/")), c => c.charCodeAt(0));
+const b64url = value => btoa(String.fromCharCode(...value)).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
+const decode = value => JSON.parse(new TextDecoder().decode(b64bytes(value)));
+export async function keyDigest(key) {
+  return Array.from(new Uint8Array(await crypto.subtle.digest("SHA-256", encoder.encode(key))), b => b.toString(16).padStart(2, "0")).join("");
+}
+
+// comma's device-info API returns OpenSSH public keys, not client-provided JWKs.
+function sshJwk(publicKey, alg) {
+  if (typeof publicKey !== "string" || publicKey.length > 8192) throw new Error("key");
+  const [type, encoded] = publicKey.trim().split(/\s+/);
+  const bytes = b64bytes(encoded);
+  let offset = 0;
+  const field = () => {
+    if (offset + 4 > bytes.length) throw new Error("key");
+    const size = new DataView(bytes.buffer).getUint32(offset);
+    offset += 4;
+    if (offset + size > bytes.length) throw new Error("key");
+    const result = bytes.slice(offset, offset + size);
+    offset += size;
+    return result;
+  };
+  if (new TextDecoder().decode(field()) !== type) throw new Error("key");
+  if (type === "ssh-rsa" && alg === "RS256") {
+    const exponent = field(), modulus = field();
+    const n = modulus[0] === 0 ? modulus.slice(1) : modulus;
+    if (offset !== bytes.length || n.length < 256 || n.length > 512) throw new Error("key");
+    return { kty: "RSA", e: b64url(exponent), n: b64url(n), alg, ext: true };
+  }
+  if (type === "ecdsa-sha2-nistp256" && alg === "ES256") {
+    const curve = new TextDecoder().decode(field()), point = field();
+    if (offset !== bytes.length || curve !== "nistp256" || point.length !== 65 || point[0] !== 4) throw new Error("key");
+    return { kty: "EC", crv: "P-256", x: b64url(point.slice(1, 33)), y: b64url(point.slice(33)), ext: true };
+  }
+  throw new Error("key");
+}
+
+async function boundedJson(response, limit) {
+  if (!response.body) throw new Error("body");
+  const reader = response.body.getReader();
+  const chunks = [];
+  let total = 0;
+  try {
+    for (;;) {
+      const { done, value } = await reader.read();
+      if (done) break;
+      total += value.length;
+      if (total > limit) throw new Error("size");
+      chunks.push(value);
+    }
+  } finally { await reader.cancel(); }
+  const all = new Uint8Array(total);
+  let offset = 0;
+  for (const chunk of chunks) { all.set(chunk, offset); offset += chunk.length; }
+  return JSON.parse(new TextDecoder().decode(all));
+}
+
+export async function verifyDeviceProof(proof, deviceId, requestId, keyHash, fetcher = fetch, now = Date.now() / 1000) {
+  let parts, header, payload;
+  try {
+    if (typeof proof !== "string" || proof.length > 4096 || !/^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$/.test(proof)) return false;
+    parts = proof.split("."); header = decode(parts[0]); payload = decode(parts[1]);
+    if (!["RS256", "ES256"].includes(header.alg) || header.crit || header.jku || header.jwk) return false;
+    if (payload.identity !== deviceId || payload.hylink?.purpose !== "key-reissue-v1"
+        || payload.hylink.requestId !== requestId || payload.hylink.newKeyHash !== keyHash) return false;
+    const { iat, nbf, exp } = payload;
+    if (![iat, nbf, exp].every(Number.isFinite) || exp <= now || iat > now + 30 || nbf > now + 30
+        || exp <= iat || exp - iat > 300 || now - iat > 300 || nbf < iat - 30) return false;
+  } catch { return false; }
+
+  // Pinned authority. Never follow redirects carrying the device JWT.
+  let info;
+  try {
+    const response = await fetcher(`https://api.commadotai.com/v1.1/devices/${deviceId}/`, {
+      headers: { Authorization: `JWT ${proof}` }, redirect: "error", signal: AbortSignal.timeout(8000),
+    });
+    if ([401, 403, 404].includes(response.status)) return false;
+    if (!response.ok) throw new Error("authority_unavailable");
+    info = await boundedJson(response, 32768);
+  } catch { throw new Error("authority_unavailable"); }
+  try {
+    if (info.dongle_id !== deviceId) return false;
+    const jwk = sshJwk(info.public_key, header.alg);
+    const algorithm = header.alg === "RS256"
+      ? { name: "RSASSA-PKCS1-v1_5", hash: "SHA-256" } : { name: "ECDSA", namedCurve: "P-256", hash: "SHA-256" };
+    const key = await crypto.subtle.importKey("jwk", jwk, algorithm, false, ["verify"]);
+    return await crypto.subtle.verify(algorithm, key, b64bytes(parts[2]), encoder.encode(parts.slice(0, 2).join(".")));
+  } catch { return false; }
+}
+
+async function closeRelays(env, deviceId) {
+  if (!env.DEVICE_RELAY) return;
+  for (const kind of ["ssh", "live"]) {
+    const id = env.DEVICE_RELAY.idFromName(`${deviceId}:${kind}`);
+    const response = await env.DEVICE_RELAY.get(id).fetch(new Request("https://wayon.internal/revoke-key", { method: "POST" }));
+    if (!response.ok) throw new Error("relay_unavailable");
+  }
+}
+
+export async function handleDeviceReissue(request, env, fetcher = fetch) {
+  let body;
+  try { body = await boundedJson(request, 6144); } catch { return reply({ error: "invalid_reissue" }, 400); }
+  const { deviceId, requestId, key, proof } = body || {};
+  if (typeof deviceId !== "string" || deviceId.length !== 16 || !/^[0-9a-f]{16}$/.test(deviceId)
+      || typeof requestId !== "string" || requestId.length !== 32 || !/^[0-9a-f]{32}$/.test(requestId)
+      || typeof key !== "string" || key.length !== 49 || !/^wayon_[A-Za-z0-9_-]{43}$/.test(key)) return reply({ error: "invalid_reissue" }, 400);
+  const keyHash = await keyDigest(key);
+  try {
+    if (!await verifyDeviceProof(proof, deviceId, requestId, keyHash, fetcher)) return reply({ error: "device_proof_rejected" }, 403);
+  } catch { return reply({ error: "authority_unavailable" }, 503); }
+
+  try {
+    const device = await env.DB.prepare("SELECT key_hash, revoked_at FROM wayon_devices WHERE device_id = ?").bind(deviceId).first();
+    // A revoked device is an administrative block, not a recoverable lost key.
+    if (!device || device.revoked_at) return reply({ error: "device_not_registered" }, 409);
+    const previous = await env.DB.prepare("SELECT key_hash FROM wayon_key_reissues WHERE device_id = ? AND request_id = ?")
+      .bind(deviceId, requestId).first();
+    if (previous) {
+      if (previous.key_hash !== keyHash || device.key_hash !== keyHash) return reply({ error: "reissue_superseded" }, 409);
+    } else {
+      const now = new Date(Date.now()).toISOString();
+      const cutoff = new Date(Date.now() - 30000).toISOString();
+      // D1 batch is a transaction. Compare-and-swap guards concurrent requests;
+      // plaintext keys, identity JWTs and private keys never enter the database.
+      const results = await env.DB.batch([
+        env.DB.prepare(`INSERT INTO wayon_key_reissues (device_id, request_id, key_hash, previous_key_hash, completed_at)
+          SELECT ?, ?, ?, ?, ? WHERE EXISTS (
+            SELECT 1 FROM wayon_devices WHERE device_id = ? AND key_hash = ? AND revoked_at IS NULL
+          ) AND NOT EXISTS (SELECT 1 FROM wayon_key_reissues WHERE device_id = ? AND completed_at > ?)
+          ON CONFLICT(device_id, request_id) DO NOTHING`)
+          .bind(deviceId, requestId, keyHash, device.key_hash, now, deviceId, device.key_hash, deviceId, cutoff),
+        env.DB.prepare(`UPDATE wayon_devices SET key_hash = ?, updated_at = ? WHERE device_id = ? AND key_hash = ?
+          AND revoked_at IS NULL AND EXISTS (SELECT 1 FROM wayon_key_reissues WHERE device_id = ? AND request_id = ? AND key_hash = ?)`)
+          .bind(keyHash, now, deviceId, device.key_hash, deviceId, requestId, keyHash),
+        env.DB.prepare("DELETE FROM push_subscriptions WHERE device_id = ? AND changes() = 1").bind(deviceId),
+      ]);
+      if (results[1].meta.changes !== 1) return reply({ error: "reissue_busy" }, 409);
+    }
+    // Retry after a lost acknowledgement also retries closing old sessions.
+    await closeRelays(env, deviceId);
+    return reply({ ok: true, deviceId, requestId, keyHash });
+  } catch { return reply({ error: "reissue_unavailable" }, 503); }
+}
diff --git a/cloudflare/wayon-cloud/test_device_reissue.mjs b/cloudflare/wayon-cloud/test_device_reissue.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..82a022bf7eeb78184fc2b096ffb2bc85f94bbd51
--- /dev/null
+++ b/cloudflare/wayon-cloud/test_device_reissue.mjs
@@ -0,0 +1,174 @@
+// Synthetic identities only. SQLite executes the real D1 statements/transactions.
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { DatabaseSync } from "node:sqlite";
+import { generateKeyPairSync, sign } from "node:crypto";
+import { handleDeviceReissue, verifyDeviceProof, keyDigest } from "./src/device_reissue.mjs";
+import worker, { WayonDeviceRelay, verifyLiveProtocol, verifyRemoteSshProtocol } from "./src/worker.js";
+
+const deviceId = "0123456789abcdef", otherId = "fedcba9876543210";
+const oldKey = "wayon_" + "a".repeat(43), nextKey = "wayon_" + "b".repeat(43), otherKey = "wayon_" + "c".repeat(43);
+const requestId = "1".repeat(32), otherRequest = "2".repeat(32);
+let clock = Date.now();
+const realNow = Date.now;
+Date.now = () => clock;
+const field = value => {
+  const data = Buffer.isBuffer(value) ? value : Buffer.from(value);
+  const size = Buffer.alloc(4); size.writeUInt32BE(data.length);
+  return Buffer.concat([size, data]);
+};
+function identity(alg) {
+  const pair = alg === "RS256" ? generateKeyPairSync("rsa", { modulusLength: 2048 })
+    : generateKeyPairSync("ec", { namedCurve: "P-256" });
+  const jwk = pair.publicKey.export({ format: "jwk" });
+  const type = alg === "RS256" ? "ssh-rsa" : "ecdsa-sha2-nistp256";
+  const fields = alg === "RS256" ? [field(type), field(Buffer.from(jwk.e, "base64url")), field(Buffer.concat([Buffer.from([0]), Buffer.from(jwk.n, "base64url")]))]
+    : [field(type), field("nistp256"), field(Buffer.concat([Buffer.from([4]), Buffer.from(jwk.x, "base64url"), Buffer.from(jwk.y, "base64url")]))];
+  return { ...pair, alg, ssh: `${type} ${Buffer.concat(fields).toString("base64")} synthetic` };
+}
+const rsa = identity("RS256"), ec = identity("ES256");
+async function proof(key = nextKey, id = requestId, signer = rsa, extra = {}) {
+  const header = Buffer.from(JSON.stringify({ alg: signer.alg, typ: "JWT" })).toString("base64url");
+  const now = Math.floor(clock / 1000);
+  const payload = Buffer.from(JSON.stringify({ identity: deviceId, iat: now, nbf: now, exp: now + 300,
+    hylink: { purpose: "key-reissue-v1", requestId: id, newKeyHash: await keyDigest(key) }, ...extra })).toString("base64url");
+  const data = `${header}.${payload}`;
+  return data + "." + sign("sha256", Buffer.from(data), { key: signer.privateKey, dsaEncoding: "ieee-p1363" }).toString("base64url");
+}
+let authorityCalls = 0;
+const authority = signer => async (url, options) => {
+  authorityCalls++;
+  assert.equal(url, `https://api.commadotai.com/v1.1/devices/${deviceId}/`);
+  assert.equal(options.redirect, "error");
+  assert.ok(options.headers.Authorization.startsWith("JWT "));
+  return Response.json({ dongle_id: deviceId, public_key: signer.ssh });
+};
+const hash = await keyDigest(nextKey);
+for (const signer of [rsa, ec]) {
+  const signed = await proof(nextKey, requestId, signer);
+  assert.equal(await verifyDeviceProof(signed, deviceId, requestId, hash, authority(signer)), true);
+  assert.equal(await verifyDeviceProof(signed, otherId, requestId, hash, authority(signer)), false);
+  assert.equal(await verifyDeviceProof(signed, deviceId, otherRequest, hash, authority(signer)), false);
+  assert.equal(await verifyDeviceProof(signed, deviceId, requestId, "f".repeat(64), authority(signer)), false);
+}
+const forged = await proof(nextKey, requestId, identity("RS256"));
+assert.equal(await verifyDeviceProof(forged, deviceId, requestId, hash, authority(rsa)), false);
+for (const extra of [{ exp: 0 }, { exp: Math.floor(clock / 1000) + 301 }, { iat: Math.floor(clock / 1000) + 31 }, { hylink: {} }]) {
+  assert.equal(await verifyDeviceProof(await proof(nextKey, requestId, rsa, extra), deviceId, requestId, hash, authority(rsa)), false);
+}
+assert.equal(await verifyDeviceProof("bad", deviceId, requestId, hash, authority(rsa)), false);
+assert.equal(await verifyDeviceProof(await proof(), deviceId, requestId, hash, async () => Response.json({ dongle_id: otherId, public_key: rsa.ssh })), false);
+assert.equal(await verifyDeviceProof(await proof(), deviceId, requestId, hash, async () => new Response(null, { status: 401 })), false);
+await assert.rejects(verifyDeviceProof(await proof(), deviceId, requestId, hash, async () => new Response(null, { status: 503 })), /authority_unavailable/);
+await assert.rejects(verifyDeviceProof(await proof(), deviceId, requestId, hash, async () => new Response("x".repeat(32769))), /authority_unavailable/);
+
+const sqlite = new DatabaseSync(":memory:");
+sqlite.exec(readFileSync(new URL("schema.sql", import.meta.url), "utf8"));
+// Both fresh install and reapplying the additive migration are harmless.
+sqlite.exec(readFileSync(new URL("migrations/0010_device_key_reissues.sql", import.meta.url), "utf8"));
+sqlite.exec(readFileSync(new URL("migrations/0010_device_key_reissues.sql", import.meta.url), "utf8"));
+const oldHash = await keyDigest(oldKey), otherHash = await keyDigest(otherKey);
+for (const [id, keyHash] of [[deviceId, oldHash], [otherId, otherHash]]) {
+  sqlite.prepare("INSERT INTO wayon_devices (device_id, key_hash, created_at, updated_at) VALUES (?, ?, ?, ?)").run(id, keyHash, "old", "old");
+  sqlite.prepare("INSERT INTO push_subscriptions (token, device_id, platform, created_at, updated_at) VALUES (?, ?, 'android', 'old', 'old')").run(id + "-push", id);
+}
+// A separate history sentinel must never be removed by credential rotation.
+sqlite.exec("CREATE TABLE history_sentinel (device_id TEXT PRIMARY KEY, value TEXT)");
+sqlite.prepare("INSERT INTO history_sentinel VALUES (?, 'preserve')").run(deviceId);
+let failBatch = false;
+const db = {
+  prepare(sql) {
+    return { bind(...args) {
+      return { first: async () => sqlite.prepare(sql).get(...args),
+        run: async () => ({ meta: { changes: Number(sqlite.prepare(sql).run(...args).changes) } }),
+        execute: () => ({ meta: { changes: Number(sqlite.prepare(sql).run(...args).changes) } }),
+      };
+    } };
+  },
+  async batch(statements) {
+    sqlite.exec("BEGIN");
+    try {
+      const results = [];
